{
  "name": "entregas-api",
  "version": "1.0.0",
  "description": "API de Entregas (Grupo 7) - Integração de Aplicações via API REST",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "docs:gerar": "tsx scripts/gerar-docs.ts",
    "test:postman": "newman run docs/postman/entregas-g7.postman_collection.json -e docs/postman/entregas-g7-local.postman_environment.json",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "importar:pedidos": "tsx --env-file=.env src/cli/importar-pedidos.ts",
    "migrate": "tsx --env-file=.env src/shared/database/migrate-cli.ts",
    "test": "vitest run --configLoader runner"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "newman": "^6.2.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
