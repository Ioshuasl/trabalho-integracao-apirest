    {
      "name": "04 Integração G5 (interno)",
      "description": "Consumo da API de Pedidos do Grupo 5. Para completar as pendências de uma entrega importada, use PUT /entregas/{id}.",
      "item": [
        {
          "name": "POST /integracoes/pedidos/importar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/integracoes/pedidos/importar",
            "description": "Requer a API do G5 no ar (G5_BASE_URL). Cria as entregas dos pedidos CONFIRMADOS e atualiza/cancela as já importadas; campos que o G5 não envia ficam em `pendencias`. Com o G5 fora do ar responde 503 INTEGRACAO_INDISPONIVEL (após 3 repetições, cerca de 7 s)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (resumo) ou erro de integração documentado', () => pm.expect([200, 502, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('resumo completo', () => { const r = pm.response.json(); ['importacao_id', 'consultados', 'inseridos', 'atualizados', 'sem_alteracao', 'ignorados', 'rejeitados'].forEach(k => pm.expect(r).to.have.property(k)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /integracoes/pedidos — pedidos importados",
          "request": {
