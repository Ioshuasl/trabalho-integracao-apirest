{
  "info": {
    "name": "API de Entregas — Grupo 7",
    "description": "Coleção do contrato de integração v1.0. Rode a pasta \"01 Fluxo completo\" na ordem (Collection Runner) e depois as demais. Variáveis: baseUrl, apiKey, apiKeyLeitura (ver o ambiente \"Entregas G7 — local\").",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Datas e ids gerados a cada execução para os testes não colidirem entre si",
          "// A API usa America/Sao_Paulo para definir \"hoje\"; calcular em UTC erraria o dia à noite",
          "const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toLocaleDateString('sv-SE', { timeZone: 'America/Sao_Paulo' }); };",
          "pm.collectionVariables.set('dataPrevista', dia(7));",
          "pm.collectionVariables.set('hoje', dia(0));",
          "if (!pm.collectionVariables.get('idPedido')) pm.collectionVariables.set('idPedido', String(Math.floor(Math.random() * 900000) + 100000));",
          "if (!pm.collectionVariables.get('idPedidoExclusao')) pm.collectionVariables.set('idPedidoExclusao', String(Math.floor(Math.random() * 900000) + 1000000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5007/api/v1"
    },
    {
      "key": "apiKey",
      "value": "g7-entregas-admin-2026"
    },
    {
      "key": "apiKeyLeitura",
      "value": "g2-vendas-leitura-2026"
    },
    {
      "key": "idEntrega",
      "value": ""
    },
    {
      "key": "idEntregaExclusao",
      "value": ""
    },
    {
      "key": "idPedido",
      "value": ""
    },
    {
      "key": "idPedidoExclusao",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Saúde",
      "item": [
        {
          "name": "GET /health (sem chave)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Fluxo completo",
      "description": "Execute na ordem: cada passo usa o id guardado pelo cadastro.",
      "item": [
        {
          "name": "POST /entregas — cadastrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_pedido\": {{idPedido}},\n  \"id_cliente\": 1034,\n  \"nome_destinatario\": \"Maria Souza\",\n  \"transportadora\": \"Correios\",\n  \"endereco_destino\": {\n      \"logradouro\": \"Rua das Flores\",\n      \"numero\": \"120\",\n      \"complemento\": \"Apto 32\",\n      \"bairro\": \"Centro\",\n      \"cidade\": \"Campinas\",\n      \"uf\": \"SP\",\n      \"cep\": \"13010-100\"\n  },\n  \"data_prevista\": \"{{dataPrevista}}\",\n  \"valor_frete\": 25.90\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/entregas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const e = pm.response.json();",
                  "pm.test('código de rastreio e status inicial', () => { pm.expect(e.codigo_rastreio).to.match(/^ENT-\\d{4}-\\d{6}$/); pm.expect(e.status_entrega).to.eql('AGUARDANDO_COLETA'); });",
                  "pm.test('Location aponta para o recurso', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/v1/entregas/' + e.id_entrega));",
                  "pm.test('X-Request-Id devolvido', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));",
                  "pm.collectionVariables.set('idEntrega', String(e.id_entrega));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /entregas?id_pedido — listar",
          "request": {
            "method": "GET",
            "header": [
