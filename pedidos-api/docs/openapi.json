  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Chave de administração (G5) ou chave do G7 (somente GET em /integracao/*)."
      }
    },
    "parameters": {
      "XRequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "description": "UUID do consumidor; devolvido na resposta e no corpo de erro. A API gera um se ausente.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "RequisicaoInvalida": {
        "description": "JSON malformado, campo obrigatório ausente, tipo errado, Content-Type inválido ou parâmetro inválido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": {
                "status": 400,
                "codigo": "REQUISICAO_INVALIDA",
                "mensagem": "JSON malformado, campo obrigatório ausente, tipo errado, Content-Type inválido ou parâmetro inválido",
                "detalhes": [
