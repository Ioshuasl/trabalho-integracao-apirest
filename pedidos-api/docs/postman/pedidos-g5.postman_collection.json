                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));",
                  "pm.test('erro.codigo = SEM_PERMISSAO', () => { const j = pm.response.json(); pm.expect(j.erro.codigo).to.eql('SEM_PERMISSAO'); pm.expect(j.request_id).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "400 — paginação inválida",
          "request": {
            "method": "GET",
            "header": [
              {
