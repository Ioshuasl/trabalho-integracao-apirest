{
  "info": {
    "name": "API de Pedidos — Grupo 5",
    "description": "Coleção do contrato v1.0. Pré-requisito: `npm run seed` (clientes 1-7, pedidos 101-108). Rode as pastas na ordem (Collection Runner). Variáveis: baseUrl, apiKey (admin), apiKeyG7 (somente /integracao).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5005/api/v1"
    },
    {
      "key": "apiKey",
      "value": "g5-pedidos-admin-2026"
    },
    {
      "key": "apiKeyG7",
      "value": "g7-entregas-leitura-2026"
    },
    {
      "key": "idPedido",
      "value": ""
    },
    {
      "key": "idPedidoExclusao",
      "value": ""
    },
    {
      "key": "idCliente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Saúde",
      "item": [
        {
          "name": "GET /health (sem chave)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Integração (consumida pelo G7)",
      "description": "O G7 só enxerga esta estrutura (Contrato B): pedidos CONFIRMADO ou CANCELADO, sem itens.",
      "item": [
        {
          "name": "GET /integracao/pedidos — chave do G7",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKeyG7}}"
              }
            ],
            "url": "{{baseUrl}}/integracao/pedidos?tamanho=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('só CONFIRMADO/CANCELADO e sem itens', () => { const j = pm.response.json(); pm.expect(j.dados.length).to.be.above(0); j.dados.forEach(p => { pm.expect(['CONFIRMADO', 'CANCELADO']).to.include(p.status_pedido); pm.expect(p).to.not.have.property('itens'); }); });",
                  "pm.test('campos do Contrato B', () => pm.expect(pm.response.json().dados[0]).to.have.all.keys('codigo_pedido', 'codigo_cliente', 'nome_cliente', 'endereco_entrega', 'cidade_entrega', 'uf_entrega', 'cep_entrega', 'data_pedido', 'quantidade_itens', 'valor_total', 'status_pedido', 'data_atualizacao'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /integracao/pedidos — paginação",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKeyG7}}"
              }
            ],
            "url": "{{baseUrl}}/integracao/pedidos?pagina=1&tamanho=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('2 por página', () => { const j = pm.response.json(); pm.expect(j.dados).to.have.length(2); pm.expect(j.paginacao.tamanho).to.eql(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "403 — chave do G7 fora de /integracao",
          "request": {
            "method": "GET",
            "header": [
              {
