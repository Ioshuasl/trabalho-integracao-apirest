              },
              {
                "key": "X-Request-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKeyG7}}"
              }
            ],
            "url": "{{baseUrl}}/integracao/pedidos?tamanho=500"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
